# ─────────────────────────────────────────
#  MindEase — Environment Variables
#  Copy this file to .env and fill values
# ─────────────────────────────────────────

# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Set to "true" ONLY during local development
FLASK_DEBUG=false

# Long random string for session security
FLASK_SECRET_KEY=change-me-to-a-long-random-string
